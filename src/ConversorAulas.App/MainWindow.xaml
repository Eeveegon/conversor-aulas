<Window x:Class="ConversorAulas.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:ConversorAulas.App.Controls"
 Title="Conversor de Audio de Aulas">
 <Grid x:Name="Root" RequestedTheme="Default" Padding="32" RowSpacing="20" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="6">
   <TextBlock Text="Converter áudios" FontSize="30" FontWeight="SemiBold" />
   <TextBlock Text="Converte as gravações em ficheiros mais pequenos, mantendo uma boa qualidade de audição." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE8D6;" FontSize="24" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
     <TextBlock x:Name="OutputFormatText" Text="Formato de saída: Opus (.opus) · 64 kbps · 48 kHz" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Todos os áudios serão convertidos para este formato. As cópias ficam na mesma pasta, sem alterar os originais." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="8" Width="200" VerticalAlignment="Center">
    <controls:AudioFrequencyComboBox x:Name="FormatBox" Header="Formato" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Format_Changed">
     <ComboBoxItem Content="Opus (.opus)"/>
     <ComboBoxItem Content="AAC (.m4a)"/>
    </controls:AudioFrequencyComboBox>
    <controls:AudioFrequencyComboBox x:Name="SampleRateBox" Header="Frequência" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="SampleRate_Changed">
     <ComboBoxItem Content="48 kHz (recomendado)" Tag="48000"/>
     <ComboBoxItem Content="24 kHz (voz)" Tag="24000"/>
     <ComboBoxItem Content="16 kHz (voz)" Tag="16000"/>
    </controls:AudioFrequencyComboBox>
    <controls:AudioFrequencyComboBox x:Name="AacSampleRateBox" Header="Frequência" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="SampleRate_Changed" Visibility="Collapsed">
     <ComboBoxItem Content="44,1 kHz (recomendado)" Tag="44100"/>
     <ComboBoxItem Content="48 kHz" Tag="48000"/>
     <ComboBoxItem Content="24 kHz (voz)" Tag="24000"/>
     <ComboBoxItem Content="16 kHz (voz)" Tag="16000"/>
    </controls:AudioFrequencyComboBox>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="FilesButton" Content="Adicionar ficheiros" Click="AddFiles_Click"/>
    <Button x:Name="FolderButton" Content="Adicionar pasta" Click="AddFolder_Click"/>
    <CheckBox x:Name="SubfoldersCheck" Content="Incluir subpastas" Margin="8,0,0,0"/>
   </StackPanel>
   <Button x:Name="ClearButton" Grid.Column="1" Content="Limpar lista" Click="Clear_Click" IsEnabled="False"/>
  </Grid>
  <Grid Grid.Row="3" MinHeight="160">
   <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"/>
   <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="Arrasta as gravações para aqui" FontSize="18" HorizontalAlignment="Center"/>
    <TextBlock Text="M4A, AAC, WAV, MP3 e outros formatos de áudio" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <ListView x:Name="FileList" SelectionMode="None" IsItemClickEnabled="False" Padding="8" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
    <ListView.ItemTemplate><DataTemplate>
     <Grid Padding="8,10" ColumnSpacing="20" RowSpacing="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/>
      <TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Right"/>
      <TextBlock Grid.Row="1" Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="4" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="5" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Spacing="7"><TextBlock x:Name="SummaryText" Text="Adiciona ficheiros ou uma pasta para começar." TextWrapping="Wrap"/><ProgressBar x:Name="TotalProgress" Maximum="100" Visibility="Collapsed"/></StackPanel>
   <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="Cancel_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
   <Button x:Name="ConvertButton" Grid.Column="2" Content="Converter" Style="{StaticResource AccentButtonStyle}" Click="Convert_Click" IsEnabled="False" MinWidth="140" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
